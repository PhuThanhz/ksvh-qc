# ==============================================================================
# Biến môi trường KSVH QC System (.env)
# Sao chép file này sang .env trước khi khởi chạy: cp .env.example .env
# ==============================================================================

# 1. Cấu hình Database PostgreSQL
DB_NAME=ksvh_qc
DB_USERNAME=postgres
DB_PASSWORD=ThayDoiMatKhauDbManhTaiDay_2026!
DB_PORT=5432

# 2. Cấu hình Bảo mật & JWT (Bắt buộc tối thiểu 32 ký tự ở môi trường chạy thật)
JWT_SECRET=ksvh-production-secret-key-must-be-at-least-32-chars-long-12345
SPRING_PROFILES_ACTIVE=prod

# 3. Cấu hình Tên miền & CORS (Ví dụ: https://qc.ksvh.vn)
APP_CLIENT_URL=https://qc.ksvh.vn
CORS_ALLOWED_ORIGINS=https://qc.ksvh.vn
AUTH_ALLOWED_ORIGINS=https://qc.ksvh.vn

# 4. Cấu hình MinIO / S3 Storage (Lưu trữ ảnh chấm QC hiện trường)
S3_ACCESS_KEY=ksvh_s3_admin
S3_SECRET_KEY=ThayDoiMatKhauS3ManhTaiDay_2026!
S3_BUCKET=ksvh-qc
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_PUBLIC_ENDPOINT=https://qc.ksvh.vn/storage

# 5. Cấu hình Cổng dịch vụ Web
FRONTEND_PORT=80
BACKEND_PORT=8088

# 6. Kênh thông báo ngoài Email (SMTP)
NOTIFICATION_MAIL_ENABLED=false
NOTIFICATION_MAIL_FROM=noreply@ksvh.vn
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@ksvh.vn
MAIL_PASSWORD=your-app-password

# 7. Kênh thông báo ngoài Zalo (ZNS)
NOTIFICATION_ZALO_ENABLED=false
